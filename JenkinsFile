pipeline {
   
   agent any

parameter {
    string(name: 'STACK_NAME', description: 'Name of the CloudFormation stack to create')
    string(name: 'REGION', defaultValue: 'ap-south-1', description: 'AWS region to deploy the stack')
    string(name: 'VPC_ID',  description: 'VPC ID where the EKS cluster is deployed')
    string(name: 'SUBNET_IDS', defaultValue: 'subnet-0b6d911bc173f3c89,subnet-0b3f113e6e4206a30', description: 'Comma-separated list of subnet IDs for the node group')
    string(name: 'SECURITY_GROUP', description: 'Security Group ID for the EKS cluster')
    string(name: 'INSTANCE_TYPES', defaultValue: 'c6a.large', description: 'Instance types for the node group')

}

stages {
    stage('Git Checkout'){
        steps {
            git branch: 'main', url: 'https://github.com/your-repo/your-project.git'
        }
    }
    stage('Deploy EKS Cluster') {
        steps {
            scripts{
                sh 'python eks-cluster-deploy.py --stack-name ${STACK_NAME} --region ${REGION} --subnet-ids ${SUBNET_IDS} --vpc-id ${VPC_ID} --security-group ${SECURITY_GROUP}'
            }
        }
    }
    stage('Deploy EKS Node Group') {
        steps{
            scripts{
                sh 'python eks-nodegroup-deploy.py --stack-name ${STACK_NAME} --region ${REGION} --subnet-ids ${SUBNET_IDS} --instance-types ${INSTANCE_TYPES}'
            }
        }
    }
    stage('Attach EKS Addons') {
        steps{
            scripts{
                sh 'python eks-addons-attach.py --stack-name ${STACK_NAME} --region ${REGION}'
            }
        }
    }
 }
 post {
        always {
            cleanWs()
        }
        success {
            echo 'EKS Cluster and Node Group deployed successfully!'
        }
        failure {
                echo 'Deployment failed. Please check the logs for details.'
            }
    }
}